# Copy to .env locally. Replace every example value before starting services.
POSTGRES_DB=iot_monitor
POSTGRES_USER=iot_app
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
DEVICE_API_KEY=replace-with-a-long-random-device-key
THINGSPEAK_WRITE_API_KEY=
JWT_SECRET=replace-with-at-least-32-random-bytes
DEMO_USER=team-demo
DEMO_PASSWORD=replace-with-a-long-random-demo-password
DEMO_DEVICE_ID=esp32c3-01
# Optional: use the computer's private LAN IP for a local ESP32 demo; otherwise API is loopback-only.
API_BIND_ADDRESS=127.0.0.1
# Segurança PI: Código de missão de 6 caracteres fornecido pelo professor (ex: K7Q2M9)
MISSION_CODE=K7Q2M9
# Chave de 32 caracteres para criptografia AES-256-GCM do segredo OTP/TOTP no banco
OTP_ENCRYPTION_KEY=replace-with-at-least-32-random-bytes-otp-key
